# ==============================================================================
# Trade Client Backend — Environment Configuration Template
# Use .env locally; configure secrets privately in the Vercel project settings.
# ==============================================================================

# Server Network Settings
PORT=4050
HOST=0.0.0.0
NODE_ENV=production

# Database (MongoDB Connection String)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/trade-client?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/trade-client

# Native authentication: generate a private random secret (at least 32 bytes).
# Existing Supabase tokens will no longer authenticate after switching.
AUTH_JWT_SECRET=replace-with-a-random-secret-before-starting
# Independent AES-256 encryption key: 64 random hexadecimal characters.
# Preserve this key when deploying or rotating JWT secrets; back it up securely.
AUTH_TOTP_ENCRYPTION_KEY=

# Account emails: SMTP with TLS; use port 465 for implicit TLS or 587 for STARTTLS.
AUTH_FRONTEND_URL=https://trade-client-frontend.vercel.app
AUTH_EMAIL_FROM=Trade Client <accounts@your-domain.example>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Security & CORS
# Trust only proxy source addresses/CIDRs under your control. Never use '*',
# a hop count, or all public IPs. Loopback supports Nginx on the same server.
# Vercel requests may share a proxy-IP bucket unless its source networks are
# explicitly trusted; per-email limits are independent of proxy addresses.
TRUSTED_PROXY_CIDRS=loopback
# Comma-separated allowed frontend origins. Wildcard access is not enabled.
CORS_ORIGIN=https://trade-client-frontend.vercel.app

# API Documentation (Swagger)
# Set to 'false' if you wish to disable /docs in production
SWAGGER_ENABLED=true

# External Integrations (OEM & PartsCheck)
# Mode: 'mock' | 'live' | 'hybrid'
INTEGRATION_MODE=hybrid

# PartsCheck API Credentials
PARTSCHECK_API_URL=https://api.partscheck.com.au/v2
PARTSCHECK_API_KEY=your_partscheck_api_key
PARTSCHECK_WEBHOOK_SECRET=your_partscheck_webhook_secret

# OEM Gateway Configuration
OEM_GATEWAY_URL=https://oem-gateway.booran.internal/api/v1
OEM_GATEWAY_API_KEY=your_oem_gateway_key

# Capricorn Integration
CAPRICORN_API_URL=https://api.capricorn.coop/v1
CAPRICORN_CLIENT_ID=cap_booran_motor_group
